# Copy this file to .env for local Docker Compose use. Never commit .env.
POSTGRES_DB=cloudpilot
POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Optional until an OIDC provider is selected and configured.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_SCOPES=openid profile email
OIDC_CALLBACK_URL=
COOKIE_SECURE=false

# ==============================================================================
# CloudPilot Environment Configuration Template
# Copy this file to .env and fill in required values. Never commit .env.
# ==============================================================================

# Application & Runtime
APP_ENV=development
HTTP_ADDR=:8080

# Database (PostgreSQL)
POSTGRES_DB=cloudpilot
POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgres://cloudpilot:replace-with-a-local-development-password@localhost:5432/cloudpilot?sslmode=disable

# Frontend & API Connectivity
VITE_API_URL=http://localhost:8080/cloudpilot

# CORS & Cookies
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.cloudpilot.io
COOKIE_SECURE=false

# OpenID Connect (OIDC / OAuth2)
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_SCOPES=openid profile email
OIDC_CALLBACK_URL=http://localhost:8080/cloudpilot/auth/callback

# AI Copilot & Engine Configuration ("mock", "gemini", "openai", "anthropic")
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ==============================================================================
# CloudPilot Docker Deployment Environment Configuration Template
# Place this file in deployments/docker/.env for containerized execution.
# ==============================================================================

# Application & Runtime
APP_ENV=production
HTTP_ADDR=:8080

# Database (PostgreSQL)
POSTGRES_DB=cloudpilot
POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=replace-with-a-production-password

# Frontend & API Connectivity (Routed internally via Caddy reverse proxy on port 80)
VITE_API_URL=/cloudpilot

# CORS & Cookies
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://app.cloudpilot.io
COOKIE_SECURE=false

# OpenID Connect (OIDC / OAuth2)
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_SCOPES=openid profile email
OIDC_CALLBACK_URL=http://localhost/cloudpilot/auth/callback

# AI Copilot & Engine Configuration ("mock", "gemini", "openai", "anthropic")
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

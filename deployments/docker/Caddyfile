{
    admin off
    auto_https off
}

:80 {
    root * /usr/share/caddy
    encode gzip zstd

    # CloudPilot Backend API (preserves /cloudpilot prefix)
    handle /cloudpilot/* {
        reverse_proxy http://api:8080
    }

    # CloudPilot Frontend UI (serves React app & client-side routing)
    handle {
        try_files {path} /index.html
        file_server
    }
}
